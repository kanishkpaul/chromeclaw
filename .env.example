# Keys never select a provider. Keep mock until you explicitly configure another provider.
CHROMECLAW_PROVIDER=mock
CHROMECLAW_HEADLESS=false
CHROMECLAW_MAX_STEPS=20
CHROMECLAW_TIMEOUT_MS=120000

# Hosted selection is implemented; execution remains locked pending Phase 4 accounting.
# CHROMECLAW_PROVIDER=openai
# CHROMECLAW_MODEL=your-model
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# CHROMECLAW_BASE_URL=                 # overrides selected hosted provider endpoint
# CHROMECLAW_API_KEY=                  # overrides selected hosted provider key

# Local never inherits OPENAI_API_KEY or OPENAI_BASE_URL.
# CHROMECLAW_PROVIDER=local
# CHROMECLAW_MODEL=your-installed-model
# CHROMECLAW_LOCAL_BASE_URL=http://127.0.0.1:11434/v1
# CHROMECLAW_LOCAL_API_KEY=             # only if your loopback server requires one

# Hugging Face uses its own key and endpoint when explicitly selected.
# CHROMECLAW_PROVIDER=huggingface
# CHROMECLAW_MODEL=your-model
# HF_TOKEN=
# HF_BASE_URL=https://router.huggingface.co/v1
