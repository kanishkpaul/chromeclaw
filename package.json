{
  "name": "chromeclaw",
  "version": "0.1.0",
  "private": true,
  "description": "ChromeClaw: a transparent browser-control agent for Chrome.",
  "license": "MIT",
  "packageManager": "pnpm@10.23.0",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "pnpm build:packages && pnpm --filter @chromeclaw/cli dev repl",
    "build:packages": "pnpm --filter @chromeclaw/egress --filter @chromeclaw/shared --filter @chromeclaw/browser --filter @chromeclaw/agent --filter @chromeclaw/evals build",
    "build": "pnpm build:packages && pnpm --filter @chromeclaw/cli build",
    "lint": "pnpm --filter @chromeclaw/egress lint && pnpm --filter @chromeclaw/shared lint && pnpm --filter @chromeclaw/browser lint && pnpm --filter @chromeclaw/agent lint && pnpm --filter @chromeclaw/evals lint && pnpm --filter @chromeclaw/cli lint",
    "typecheck": "pnpm --filter @chromeclaw/egress typecheck && pnpm --filter @chromeclaw/shared typecheck && pnpm --filter @chromeclaw/browser typecheck && pnpm --filter @chromeclaw/agent typecheck && pnpm --filter @chromeclaw/evals typecheck && pnpm --filter @chromeclaw/cli typecheck",
    "test": "vitest run",
    "eval": "pnpm build:packages && pnpm --filter @chromeclaw/evals eval",
    "format": "prettier --write .",
    "check": "pnpm build && pnpm typecheck && pnpm lint && pnpm test",
    "eval:credentials": "pnpm build:packages && node packages/browser/tests/credentials.browser.mjs",
    "eval:safety": "pnpm build:packages && tsx --tsconfig tsconfig.base.json packages/browser/tests/safety.browser.mjs --source",
    "eval:runtime": "pnpm build && tsx --tsconfig tsconfig.base.json packages/agent/tests/runtime.browser.mjs --source",
    "eval:configuration": "pnpm build && tsx --tsconfig tsconfig.base.json packages/agent/tests/config.browser.mjs --source",
    "eval:models": "pnpm build && tsx --tsconfig tsconfig.base.json packages/agent/tests/models.browser.mjs --source",
    "eval:local": "pnpm build && tsx --tsconfig tsconfig.base.json packages/agent/tests/models.browser.mjs --source --actual-local",
    "eval:tui": "pnpm build && python3 apps/cli/tests/tui.pty.py",
    "eval:ask": "pnpm build && tsx --tsconfig tsconfig.base.json packages/agent/tests/ask.browser.mjs",
    "eval:ask-local": "pnpm build && tsx --tsconfig tsconfig.base.json packages/agent/tests/ask.browser.mjs --actual-local",
    "eval:session": "pnpm build && node packages/browser/tests/session.browser.mjs",
    "eval:tui-local": "pnpm build && python3 apps/cli/tests/tui.pty.py --actual-local",
    "eval:find": "pnpm build && tsx --tsconfig tsconfig.base.json packages/agent/tests/find.browser.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2",
    "vitest": "^2.1.8"
  }
}
